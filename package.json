{
  "name": "workflow-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "workflow-runner": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./build --target=node && bun build ./src/infra/daemon/entry.ts --outfile ./build/daemon-entry.js --target=node",
    "compile": "bun build --compile --target=bun-linux-x64-modern ./src/index.ts --outfile=bin/workflow-runner",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test src/infra/daemon/__tests__/integration/"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.22.1",
    "@hono/zod-openapi": "^1.4.0",
    "@opentui/core": "^0.2.15",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "bun-types": "^1.3.14",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
