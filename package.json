{
  "name": "workflow-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "packageManager": "bun@1.3.14",
  "bin": {
    "workflow-runner": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun src/index.ts daemon",
    "build": "bun build ./src/index.ts --outdir ./build --target=node && bun build ./src/infra/daemon/entry.ts --outfile ./build/daemon-entry.js --target=node",
    "build:web": "cd web && bun run build",
    "gen:web-assets": "bun scripts/gen-web-assets.ts",
    "compile": "bun run build:web && bun run gen:web-assets && bun build --compile --target=bun-linux-x64-modern ./src/index.ts --outfile=bin/workflow-runner && bun run gen:web-assets --stub",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test src/infra/daemon/__tests__/integration/",
    "turbo:build": "turbo run build",
    "turbo:dev": "turbo run dev",
    "turbo:typecheck": "turbo run typecheck",
    "turbo:test": "turbo run test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.23.0",
    "@hono/zod-openapi": "^1.4.0",
    "@opentui/core": "^0.2.15",
    "hono": "^4.12.23",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "bun-types": "^1.3.14",
    "tsx": "^4.0.0",
    "turbo": "^2.9.16",
    "typescript": "^5.5.0"
  }
}
